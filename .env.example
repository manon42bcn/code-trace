# Copy the relevant blocks into .env in the checkout.
# Exported environment variables take precedence over .env.
# Keep API keys and tokens in your local .env.
# Adapter implementation guide: docs/es/adaptadores.md

# Web chat language (es or en, defaults to es).
# CHAT_LANG=es

# EMBEDDINGS
# Choose one adapter: sentence-transformers (default) or mlx.
# Documents and queries use the same adapter and model. Rebuild vectors after
# changing them. Existing chunks and relationships can be reused.

# Sentence Transformers. Omit the model override to use the repository setting,
# or all-MiniLM-L6-v2 when the repository has no embedding model setting.
# CODETRACE_EMBEDDING_PROVIDER=sentence-transformers
# CODETRACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional Hugging Face token for downloading a model (when needed).
# HF_TOKEN=

# Jina Code Embeddings for MLX on Apple silicon. Requires the mlx extra.
# Use an absolute path to the downloaded embedding model directory.
# CODETRACE_EMBEDDING_PROVIDER=mlx
# CODETRACE_EMBEDDING_MODEL=/absolute/path/to/jina-code-embeddings-1.5b-mlx

# GENERATION
# Choose one provider: none (default), ollama, mlx, anthropic, openai,
# azure_openai, openrouter, or groq. Set its model when enabling generation.
# CODETRACE_GENERATION_PROVIDER=none

# Ollama. The default endpoint is http://localhost:11434.
# CODETRACE_GENERATION_PROVIDER=ollama
# CODETRACE_GENERATION_MODEL=qwen2.5-coder:14b

# MLX LM on Apple silicon. Requires the mlx extra and a local generation model.
# CODETRACE_GENERATION_PROVIDER=mlx
# CODETRACE_GENERATION_MODEL=/absolute/path/to/mlx-generation-model

# Anthropic. Requires the llm extra. Set the API key or auth token.
# CODETRACE_GENERATION_PROVIDER=anthropic
# CODETRACE_GENERATION_MODEL=your-anthropic-model
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# OpenAI. Requires the llm extra.
# CODETRACE_GENERATION_PROVIDER=openai
# CODETRACE_GENERATION_MODEL=your-openai-model
# OPENAI_API_KEY=

# Azure OpenAI. Requires the llm extra. Use the deployment name as the model.
# CODETRACE_GENERATION_PROVIDER=azure_openai
# CODETRACE_GENERATION_MODEL=your-deployment-name
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# OpenRouter. Requires the llm extra.
# CODETRACE_GENERATION_PROVIDER=openrouter
# CODETRACE_GENERATION_MODEL=your-provider/your-model
# OPENROUTER_API_KEY=

# Groq. Requires the llm extra.
# CODETRACE_GENERATION_PROVIDER=groq
# CODETRACE_GENERATION_MODEL=your-groq-model
# GROQ_API_KEY=

# Optional generation overrides. Set only those your provider supports.
# BASE_URL selects a custom endpoint. MLX uses a local directory.
# PROXY_URL applies to Anthropic and OpenAI-compatible adapters.
# TIMEOUT_SECONDS applies to HTTP calls. Chat also has a separate --timeout.
# EFFORT applies to Anthropic.
# CODETRACE_GENERATION_BASE_URL=
# CODETRACE_GENERATION_PROXY_URL=
# CODETRACE_GENERATION_TIMEOUT_SECONDS=120
# CODETRACE_GENERATION_MAX_TOKENS=4096
# CODETRACE_GENERATION_EFFORT=medium
