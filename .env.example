# Copy to .env or export the variables in your shell.
# Uncomment a provider and its model to enable generation.
# CODETRACE_GENERATION_PROVIDER=ollama
# CODETRACE_GENERATION_MODEL=qwen2.5-coder:14b

# MLX LM on Apple silicon (use a local model directory)
# CODETRACE_GENERATION_PROVIDER=mlx
# CODETRACE_GENERATION_MODEL=/absolute/path/to/mlx-model

# Optional generation overrides
# CODETRACE_GENERATION_BASE_URL=
# CODETRACE_GENERATION_PROXY_URL=
# CODETRACE_GENERATION_TIMEOUT_SECONDS=120
# CODETRACE_GENERATION_MAX_TOKENS=4096
# CODETRACE_GENERATION_EFFORT=medium

# Fill in only the credentials for the selected provider.

# Anthropic (API key or auth token)
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# OpenAI
# OPENAI_API_KEY=

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# OpenRouter
# OPENROUTER_API_KEY=

# Groq
# GROQ_API_KEY=
