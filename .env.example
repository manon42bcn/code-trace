# Copy to .env and fill in only the variables for the selected provider.

# Anthropic (API key or auth token)
# ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=

# OpenAI
# OPENAI_API_KEY=

# Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com

# OpenRouter
# OPENROUTER_API_KEY=

# Groq
# GROQ_API_KEY=
