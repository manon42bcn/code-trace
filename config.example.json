{
  "query_profiles": {
    "code-trace-inventory": {
      "limit": 30,
      "max_chunks": 10,
      "max_chars": 40000,
      "max_tokens": 10000
    }
  },
  "skills": {
    "installations": []
  },
  "default_repository": "demo",
  "repositories": {
    "demo": {
      "path": "examples/sample_repo",
      "aliases": [
        "aplicación demo"
      ],
      "description": "Ejemplo de autenticación de usuarios."
    },
    "demo_library": {
      "path": "examples/sample_library",
      "aliases": [
        "biblioteca demo"
      ],
      "description": "Biblioteca compartida de pasos Behave del ejemplo."
    }
  },
  "indexing": {
    "languages": [
      "python",
      "javascript",
      "typescript",
      "java",
      "csharp",
      "go",
      "c",
      "cpp",
      "makefile",
      "shell",
      "lock",
      "gherkin",
      "yaml",
      "json"
    ],
    "language_overrides": {
      ".h": "c"
    },
    "chunking": {
      "strategy": "structural",
      "max_tokens": 1024,
      "overlap_tokens": 128,
      "preserve_symbols": true,
      "include_parent_context": true,
      "on_missing_parser": "error",
      "on_syntax_error": "recover"
    },
    "exclude": [
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/.venv/**",
      "**/_output/**",
      "**/.git/**"
    ],
    "isolate_parsers": false,
    "timeout_seconds": 30,
    "on_file_error": "skip"
  },
  "relationships": {
    "demo": {
      "dependencies": [
        "demo_library"
      ]
    },
    "demo_library": {
      "dependencies": [],
      "exported_steps": [
        "features/steps"
      ]
    }
  },
  "retrieval": {
    "semantic_profile": "two_stage",
    "semantic_initial_k": 1,
    "semantic_v2_weight": 0.05,
    "limit": 10,
    "embedding_model": "sentence-transformers/all-MiniLM-L6-v2",
    "semantic_enabled": true
  },
  "context": {
    "max_chunks": 3,
    "max_tokens": 2500
  },
  "generation": {
    "provider": "ollama",
    "model": "qwen2.5-coder:14b",
    "base_url": "http://localhost:11434",
    "timeout_seconds": 120,
    "max_tokens": 4096,
    "effort": "medium"
  }
}
