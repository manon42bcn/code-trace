{
  "schema_version": 1,
  "description": "Source-scoped variants of curated AICC/Fábrica questions; original lexical baseline unchanged.",
  "cases": [
    {
      "id": "aicc-scoped-writer-reader",
      "kind": "evidence",
      "question": "¿Qué funciones escriben y utilizan dataset_id en la API del evaluador?",
      "query": "En aicc-tests, dataset_id",
      "default_repo": "fabrica",
      "filters": {
        "files": [
          "acceptance/common/steps/agent_evaluator/api.py"
        ],
        "source_types": [
          "python"
        ]
      },
      "expected": {
        "repository": "aicc-tests",
        "sources": [
          {
            "path": "acceptance/common/steps/agent_evaluator/api.py",
            "symbol": "upload_dataset",
            "contains": [
              "dataset_id"
            ]
          },
          {
            "path": "acceptance/common/steps/agent_evaluator/api.py",
            "symbol": "launch_evaluation",
            "contains": [
              "dataset_id"
            ]
          }
        ]
      }
    },
